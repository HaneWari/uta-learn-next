# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# ---- Node ----
node_modules/
dist/
# a renamed build dir (e.g. while testing a build-script edge case)
dist-*/
*.tsbuildinfo

# ---- 本地数据与产物（绝不提交）----
# 用户上传的音频、生成的数据集、导出的视频都在这里
localdata/
exports/
tools/_source/

# ---- 环境与密钥 ----
.env
.env.*
!.env.example

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 临时文件 ----
*.log
*.tmp

# ---- 便携版构建产物（1GB+，绝不提交）----
dist-portable/
release-v*/

# 版本无关扩展包解压出来的模型（whisper / 翻译），走 release 扩展包分发
models/

# 临时诊断产物（截图/日志）
tools/_*
